# ToAPIs 配置
TOAPIS_API_KEY=your-ToAPIs-key
TOAPIS_BASE_URL=https://toapis.com
TOAPIS_TIMEOUT=300
# ToAPIs 出站代理：留空 = 直连（走系统路由表，公司 VPN 正常时生效）
# 临时切到自己的代理时改成：TOAPIS_PROXY_URL=http://127.0.0.1:7897
TOAPIS_PROXY_URL=

# 前端开发服务器地址
CORS_ORIGINS=["http://localhost:5173"]

# MySQL 数据库配置
DATABASE_URL=mysql+aiomysql://root:111111@localhost:3306/gpt_image2_platform
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=111111
DATABASE_NAME=gpt_image2_platform

# 批量生成并发控制
MAX_CONCURRENT_GENERATIONS=50

# 标题生成并发控制（同时调用 ToAPIs chat/completions 的最大数）
MAX_CONCURRENT_TITLE_GENERATIONS=10

# 后台轮询间隔（秒）
POLL_INTERVAL_SECONDS=5
